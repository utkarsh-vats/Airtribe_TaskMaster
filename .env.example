NODE_ENV=development
PORT=3000
# LOG_LEVEL=info  (the default; left unset so tests stay silent unless you set it)

POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=<password>
POSTGRES_DB=taskmaster
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
INVITATION_TTL_DAYS=7

# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Optional AI task descriptions (POST /api/v1/ai/task-description). Leave AI_PROVIDER empty to
# disable (the endpoint then returns 503). When set, AI_API_KEY and AI_MODEL are required.
#   AI_PROVIDER=anthropic  key: https://console.anthropic.com/settings/keys
#                          model: a Claude model id, e.g. claude-haiku-5-5
#   AI_PROVIDER=gemini     key: https://aistudio.google.com/apikey
#                          model: a Gemini model id from https://ai.google.dev/gemini-api/docs/models; e.g. gemini-3.6-flash
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
