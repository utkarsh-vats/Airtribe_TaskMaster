{
    "name": "taskmaster",
    "version": "0.1.0",
    "private": true,
    "description": "TaskMaster: a collaborative task-tracking REST API (Express 5, TypeScript, PostgreSQL, Prisma)",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "test:db": "dotenv -e .env.test -e .env -- prisma migrate deploy",
        "test": "dotenv -e .env.test -e .env -- vitest run",
        "test:watch": "dotenv -e .env.test -e .env -- vitest",
        "postinstall": "prisma generate"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.137.0",
        "@google/genai": "^2.30.0",
        "@prisma/client": "^6.0.0",
        "argon2": "^0.41.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.0",
        "dotenv-expand": "^12.0.0",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.4.0",
        "pino": "^9.0.0",
        "pino-http": "^10.0.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.1.0",
        "@eslint/js": "^9.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.0",
        "@types/swagger-ui-express": "^4.1.8",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.0.0",
        "prisma": "^6.0.0",
        "supertest": "^7.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^3.0.0"
    }
}
